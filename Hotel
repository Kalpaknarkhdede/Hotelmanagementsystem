import streamlit as st
import pandas as pd
import random
from datetime import date, datetime

# --- Configuration ---
st.set_page_config(page_title="Grand Horizon Enterprise", page_icon="🏢", layout="wide")

# --- Custom CSS for Professional Look ---
st.markdown("""
   
    """, unsafe_allow_html=True)

# --- Session State Initialization ---
if 'total_bill' not in st.session_state: st.session_state.total_bill = 0.0
if 'bookings' not in st.session_state: st.session_state.bookings = []
if 'requests' not in st.session_state: st.session_state.requests = []
if 'reviews' not in st.session_state: st.session_state.reviews = []

# --- Sidebar ---
st.sidebar.title("🏨 Horizon ERP v2.0")
st.sidebar.caption("Logged in as: Senior Manager")
page = st.sidebar.selectbox("Navigation",
    ["Analytics Overview", "Reservations & Stays", "Main Menu & Dining", "Guest Services", "Feedback & Ratings", "Final Settlement"])

# --- 1. Enhanced Overview ---
if page == "Analytics Overview":
    st.header("📈 Hotel Performance Analytics")
    
    # KPIs
    m1, m2, m3, m4 = st.columns(4)
    m1.metric("Total Revenue", f"₹{st.session_state.total_bill:,.2f}", "+12.5%")
    m2.metric("Room Occupancy", "88%", "Stable")
    m3.metric("RevPAR", "₹4,200", "+₹310")
    m4.metric("Guest Satisfaction", "4.8/5.0", "Top 1%")

    st.divider()
    
    col_left, col_right = st.columns([2, 1])
    with col_left:
        st.subheader("Occupancy Heatmap (Forecast)")
        # Simulating data for a professional look
        chart_data = pd.DataFrame({
            'Standard': [40, 45, 30, 50, 60, 80, 90],
            'Deluxe': [20, 25, 20, 30, 45, 70, 85],
            'Suite': [5, 8, 10, 12, 15, 20, 25]
        }, index=['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'])
        st.line_chart(chart_data)
        
    with col_right:
        st.subheader("Live Operations")
        st.info(f"🛎️ {len(st.session_state.requests)} Active Guest Requests")
        st.success("🧹 14 Rooms Ready for Check-in")
        room_number = "1205"
        st.warning(f"⚠️ Maintenance required in Room {room_number}")
# --- 2. Reservations ---
elif page == "Reservations & Stays":
    st.header("🛌 Reservation Management")
    c1, c2 = st.columns(2)
    with c1: check_in = st.date_input("Arrival", value=date.today())
    with c2: check_out = st.date_input("Departure", value=date.today())
    
    rooms = {
        "Executive Club": {"price": 5500, "img": "https://images.unsplash.com/photo-1566665797739-1674de7a421a?w=400"},
        "Royal Suite": {"price": 12000, "img": "https://images.unsplash.com/photo-1590490359683-658d3d23f972?w=400"},
        "Panoramic Penthouse": {"price": 25000, "img": "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=400"}
    }
    
    nights = (check_out - check_in).days
    for name, info in rooms.items():
        with st.container():
            col_img, col_txt = st.columns([1, 2])
            col_img.image(info['img'])
            col_txt.subheader(name)
            col_txt.write(f"Luxury amenities, High-speed WiFi, Complimentary Breakfast.")
            if col_txt.button(f"Reserve for ₹{info['price']}/night", key=name):
                if nights > 0:
                    cost = info['price'] * nights
                    st.session_state.total_bill += cost
                    st.session_state.bookings.append({"Item": name, "Cost": cost, "Type": "Stay"})
                    st.success(f"Reserved {name} for {nights} nights.")
                else:
                    st.error("Please select valid dates.")

# --- 3. Main Menu (Expanded) ---
elif page == "Main Menu & Dining":
    st.header("🍴 Fine Dining Menu")
    menu = {
        "Appetizers": {"Bruschetta": 450, "Calamari Rings": 650, "Stuffed Mushrooms": 500},
        "Main Course": {"Grilled Salmon": 1400, "Lamb Chops": 1800, "Risotto": 950, "Paneer Lababdar": 750},
        "Beverages": {"Vintage Red": 2500, "Fresh Lime": 200, "Blue Lagoon": 450},
        "Desserts": {"Tiramisu": 550, "Lava Cake": 400, "Fruit Platter": 350}
    }
    
    cat = st.tabs(list(menu.keys()))
    for i, category in enumerate(menu.keys()):
        with cat[i]:
            for item, price in menu[category].items():
                c_a, c_b = st.columns([3, 1])
                c_a.write(f"**{item}**")
                if c_b.button(f"Add ₹{price}", key=item):
                    st.session_state.total_bill += price
                    st.session_state.bookings.append({"Item": item, "Cost": price, "Type": "Dining"})
                    st.toast(f"Added {item}")

# --- 4. Guest Services (Special Requests) ---
elif page == "Guest Services":
    st.header("🛎️ Special Requests & Concierge")
    with st.form("request_form"):
        room_no = st.text_input("Room Number")
        req_type = st.selectbox("Request Type", ["Extra Towels", "Laundry", "Wake-up Call", "Airport Shuttle", "Repairs"])
        details = st.text_area("Additional Instructions")
        if st.form_submit_button("Submit Request"):
            st.session_state.requests.append({"Room": room_no, "Type": req_type, "Status": "Pending", "Time": datetime.now().strftime("%H:%M")})
            st.success("Request sent to department.")
    
    st.subheader("Active Requests")
    st.table(st.session_state.requests)
# --- 6. Settlement ---
elif page == "Final Settlement":
    st.header("🧾 Guest Folio")
    if st.session_state.bookings:
        df = pd.DataFrame(st.session_state.bookings)
        st.dataframe(df, use_container_width=True)
        
        tax = st.session_state.total_bill * 0.18
        grand_total = st.session_state.total_bill + tax
        
        st.subheader(f"Grand Total: ₹{grand_total:,.2f} (Inc. 18% GST)")
        
        if st.button("Complete Checkout & Print Receipt"):
            st.session_state.total_bill = 0.0
            st.session_state.bookings = []
            st.session_state.requests = []
            st.success("Checkout Successful!")
    else:
        st.info("No active billing data.")
 # --- 5. Settlement ---
elif page == "Feedback & Ratings":
    st.header("⭐ Guest Experience Survey")
    with st.expander("Rate Your Stay"):
        r_stay = st.slider("Overall Stay Experience", 1, 5, 5)
        r_food = st.slider("Food Quality", 1, 5, 5)
        r_service = st.slider("Staff Professionalism", 1, 5, 5)
        comment = st.text_input("Any specific feedback?")
        if st.button("Submit Review"):
            avg = (r_stay + r_food + r_service) / 3
            st.session_state.reviews.append({"Rating": avg, "Comment": comment})
            st.balloons()
            st.success("Thank you for your feedback!")
